# Copy outside the repository, fill secrets, chmod 600, then pass --env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=betalens
PGUSER=betalens
PGPASSWORD=
PGSCHEMA=betalens
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=betalens
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
TUSHARE_TOKEN=
TUSHARE_RPM=40
# Optional: defaults to ~/.local/share/betalens-db-manager
# BETALENS_INFRA_STATE=/path/to/persistent/state

# Optional table and mapping YAML directory (never store credentials in Git).
# BETALENS_DB_MANAGER_CONFIG=/private/config/betalens/db-manager
